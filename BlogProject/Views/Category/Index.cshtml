@model IEnumerable<MVC_BlogProject.Models.Entities.Category>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kategori Listesi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .container {
            margin-top: 50px;
        }
        table {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
        }
        th {
            background: #007bff;
            color: white;
            text-align: center;
        }
        .btn-custom {
            margin-right: 5px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2 class="text-center mb-4">📂 Kategori Listesi</h2>

        <div class="d-flex justify-content-between mb-3">
            <a asp-action="CategoryAdd" class="btn btn-primary">➕ Yeni Kategori</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover shadow-sm">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Kategori Adı</th>
                        <th>Makaleler</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.Id</td>
                            <td>@item.Name</td>
                            <td>@(item.Articles?.Count() ?? 0)</td>
                            <td>
                                <a asp-action="CategoryUpdate" asp-route-id="@item.Id" class="btn btn-warning btn-sm btn-custom">✏️ Düzenle</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm btn-custom">ℹ️ Detay</a>
                                <a asp-action="CategoryDelete" asp-route-id="@item.Id" class="btn btn-danger btn-sm btn-custom">🗑️ Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
