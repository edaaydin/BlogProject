@model MVC_BlogProject.Models.Entities.Tag

@{
    ViewData["Title"] = "Etiket Düzenle";
}

<h1>Etiket Düzenle</h1>

<form method="post" asp-action="Edit" asp-controller="Tags">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label for="Name">Etiket Adı</label>
        <input type="text" id="Name" name="Name" class="form-control" value="@Model.Name" placeholder="Etiket adını düzenleyin" required />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
    <a href="@Url.Action("Index", "Tags")" class="btn btn-secondary mt-3">Geri Dön</a>
</form>
