@model List<MVC_BlogProject.Models.Entities.Tag>

@{
    ViewData["Title"] = "Etiket Listesi";
}

<h1>Etiket Listesi</h1>

<a href="@Url.Action("Create", "Tags")" class="btn btn-success mb-3">Yeni Etiket Ekle</a>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Etiket Adı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tag in Model)
        {
            <tr>
                <td>@tag.Id</td>
                <td>@tag.Name</td>
                <td>
                    <a href="@Url.Action("Edit", "Tags", new { id = tag.Id })" class="btn btn-primary btn-sm">Düzenle</a>
                    <form method="post" action="@Url.Action("Delete", "Tags", new { id = tag.Id })" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Bu etiketi silmek istediğinizden emin misiniz?');">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
